<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.aochi</groupId>
    <artifactId>velolist</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>VeloList</name>
    <description>Cross-proxy whitelist plugin for Velocity supporting online and offline mode players</description>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
      Canonical build: velocity-api is fetched from PaperMC's public Maven repository.
      The velocity-api dependency (scope=provided) pulls in adventure and Guice transitively,
      so they do not need to be listed separately.

      When the PaperMC repository is not reachable (e.g. in an isolated CI environment),
      compile-time stubs located under src/main/java/com/velocitypowered/ are used instead.
      Those stubs have the exact same package/class/method names as the real API and are
      excluded from the final shaded jar via the maven-shade-plugin filter below.
    -->
    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!--
          Velocity API 3.5.0-SNAPSHOT – provided by the Velocity proxy at runtime.
          Listed here for compilation; when PaperMC is reachable this resolves
          the real JAR and the compile-time stubs are ignored (the real classes
          take precedence on the classpath, but the shade filter always removes
          the com/velocitypowered/ tree from the output jar anyway).
        -->
        <dependency>
            <groupId>com.velocitypowered</groupId>
            <artifactId>velocity-api</artifactId>
            <version>3.5.0-SNAPSHOT</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!--
          Transitive provided dependencies – needed when the PaperMC repository
          is NOT reachable and we fall back to the compile-time stubs.
          When velocity-api resolves normally these are already pulled in
          transitively and these entries are no-ops.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.36</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.inject</groupId>
            <artifactId>guice</artifactId>
            <version>5.1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-api</artifactId>
            <version>4.16.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-legacy</artifactId>
            <version>4.16.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- H2 embedded database (shaded into the jar) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
        </dependency>

        <!-- SnakeYAML for config.yml parsing (shaded into the jar) -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.2</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Shade plugin: bundles H2 and SnakeYAML into the plugin jar.
                 The compile-time Velocity API stubs are excluded so that only
                 the plugin's own classes and the shaded libraries end up in the jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <!-- Exclude the compile-time Velocity API stubs from the output jar. -->
                                <filter>
                                    <artifact>com.aochi:velolist</artifact>
                                    <excludes>
                                        <exclude>com/velocitypowered/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <relocations>
                                <relocation>
                                    <pattern>org.h2</pattern>
                                    <shadedPattern>com.aochi.velolist.libs.h2</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.yaml.snakeyaml</pattern>
                                    <shadedPattern>com.aochi.velolist.libs.snakeyaml</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                    <!-- The velocity-api annotation processor generates velocity-plugin.json
                         from @Plugin when the PaperMC repo is reachable.  When it is not,
                         we fall back to the hand-written src/main/resources/velocity-plugin.json.
                         We disable the AP here so the build never fails due to AP resolution. -->
                    <proc>none</proc>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

